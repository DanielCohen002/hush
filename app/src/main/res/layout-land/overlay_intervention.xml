<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the visual sits on the left, text and buttons on the right, so nothing needs
     scrolling on a short screen. Same ids as layout/overlay_intervention.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/pNight">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp"
                android:paddingVertical="16dp">

                <!-- Left: breathing visual / puzzle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- One fixed-size slot shared by the timer chip and the Open anyway button, so
                         swapping them never moves anything below. -->
                    <FrameLayout
                        android:id="@+id/topSlot"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:minWidth="140dp">

                    <TextView
                            android:id="@+id/cornerTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/timer_chip"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:textColor="?attr/pTextPrimary"
                            android:textSize="16sp"
                            android:visibility="gone" />
    
                        <!-- Takes the timer's place at the top once the countdown ends while a puzzle is showing. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/topOpenButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:minWidth="140dp"
                            android:minHeight="44dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingHorizontal="28dp"
                            android:paddingVertical="0dp"
                            android:textSize="16sp"
                            android:text="@string/overlay_open"
                            android:visibility="invisible"
                            app:cornerRadius="22dp" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <FrameLayout
                            android:id="@+id/breathFrame"
                            android:layout_width="170dp"
                            android:layout_height="170dp"
                            android:layout_gravity="center">

                            <com.djcohen.hush.BreathView
                                android:id="@+id/breathCircle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/countdownText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:fontFamily="sans-serif-thin"
                                android:textColor="?attr/pNight"
                                android:textSize="60sp"
                                tools:text="8" />
                        </FrameLayout>

                        <com.djcohen.hush.PuzzleHost
                            android:id="@+id/puzzleView"
                            android:layout_width="230dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/phaseText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minHeight="28dp"
                        android:textColor="?attr/pTextPrimary"
                        android:textSize="20sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/breatheText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.03"
                        android:text="@string/overlay_breathe"
                        android:textColor="?attr/pTextDim"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Right: what and why, then the choices -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/openingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="?attr/pTextPrimary"
                        android:textSize="22sp"
                        tools:text="Opening Instagram" />

                    <TextView
                        android:id="@+id/attemptsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:textColor="?attr/pTextDim"
                        android:textSize="14sp"
                        tools:text="Last opened 10m ago, tried 5 times in the last 24h" />

                    <LinearLayout
                        android:id="@+id/buttonsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/closeButton"
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:minHeight="52dp"
                            android:text="@string/overlay_close"
                            android:textSize="16sp"
                            app:cornerRadius="26dp" />
                        <!-- Offered only when puzzles are enabled; filled in by code. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/puzzleButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="260dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:minHeight="52dp"
                            android:text="@string/overlay_puzzle"
                            android:textColor="?attr/pBreath"
                            android:textSize="16sp"
                            android:visibility="gone"
                            app:cornerRadius="26dp"
                            app:strokeColor="?attr/pBreath"
                            app:strokeWidth="2dp" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/altSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/overlay_instead"
                            android:textColor="?attr/pTextDim"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/altRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>
    <!-- Invisible strip along the top edge: the overlay covers the status bar, so a swipe down
         from the top is caught here and opens the notification shade for you. -->
    <View
        android:id="@+id/shadeGrabber"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:clickable="true"
        android:focusable="false" />
</FrameLayout>
