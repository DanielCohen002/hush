<?xml version="1.0" encoding="utf-8"?>
<!-- Root is transparent; the panel covers the paused app. Portrait: one centred column.
     layout-land/ has the same ids in a two-column arrangement. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/pNight">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="36dp">

                <TextView
                    android:id="@+id/openingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="?attr/pTextPrimary"
                    android:textSize="22sp"
                    tools:text="Opening Instagram" />

                <TextView
                    android:id="@+id/attemptsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="?attr/pTextDim"
                    android:textSize="14sp"
                    tools:text="Last opened 10m ago, tried 5 times in the last 24h" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="24dp">

                    <FrameLayout
                        android:id="@+id/breathFrame"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center">

                        <com.dtsykunov.pause.BreathView
                            android:id="@+id/breathCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <TextView
                            android:id="@+id/countdownText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-thin"
                            android:textColor="?attr/pNight"
                            android:textSize="76sp"
                            tools:text="8" />
                    </FrameLayout>

                    <com.dtsykunov.pause.PuzzleHost
                        android:id="@+id/puzzleView"
                        android:layout_width="300dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/phaseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minHeight="28dp"
                    android:textColor="?attr/pTextPrimary"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/breatheText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:letterSpacing="0.03"
                    android:text="@string/overlay_breathe"
                    android:textColor="?attr/pTextDim"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/buttonsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!-- Available immediately so you can back out without waiting. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/closeButton"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:text="@string/overlay_close"
                        android:textSize="16sp"
                        app:cornerRadius="26dp" />
                    <!-- Offered only when puzzles are enabled; filled in by code. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/puzzleButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="52dp"
                        android:text="@string/overlay_puzzle"
                        android:textColor="?attr/pBreath"
                        android:textSize="16sp"
                        android:visibility="gone"
                        app:cornerRadius="26dp"
                        app:strokeColor="?attr/pBreath"
                        app:strokeWidth="2dp" />


                    <!-- Revealed only after the countdown finishes. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="48dp"
                        android:text="@string/overlay_open"
                        android:textColor="?attr/pTextDim"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Pre-selected apps worth opening instead; filled in by code. -->
                <LinearLayout
                    android:id="@+id/altSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/overlay_instead"
                        android:textColor="?attr/pTextDim"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/altRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
