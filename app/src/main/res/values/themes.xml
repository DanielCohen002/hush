        <item name="colorSurface">@color/lavender_panel</item>
        <item name="colorSurfaceVariant">@color/lavender_panel_variant</item>
        <item name="colorOnSurface">@color/lavender_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lavender_text_dim</item>
        <item name="colorOutline">@color/lavender_outline</item>
