<resources>
    <!-- Three runtime-selectable palettes; each has light and dark values in values/ and values-night/colors.xml. -->
    <style name="Theme.Pause.Seafoam" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="pNight">@color/teal_night</item>
        <item name="pPanel">@color/teal_panel</item>
        <item name="pPanelVariant">@color/teal_panel_variant</item>
        <item name="pBreath">@color/teal_breath</item>
        <item name="pBreathContainer">@color/teal_breath_container</item>
        <item name="pTextPrimary">@color/teal_text_primary</item>
        <item name="pTextDim">@color/teal_text_dim</item>
        <item name="pOutline">@color/teal_outline</item>
        <item name="colorPrimary">@color/teal_breath</item>
        <item name="colorOnPrimary">@color/teal_night</item>
        <item name="colorPrimaryContainer">@color/teal_breath_container</item>
        <item name="colorOnPrimaryContainer">@color/teal_breath</item>
        <item name="colorSecondary">@color/teal_breath</item>
        <item name="colorOnSecondary">@color/teal_night</item>
        <item name="colorSecondaryContainer">@color/teal_panel_variant</item>
        <item name="colorOnSecondaryContainer">@color/teal_text_primary</item>
        <item name="android:colorBackground">@color/teal_night</item>
        <item name="colorSurface">@color/teal_panel</item>
        <item name="colorSurfaceVariant">@color/teal_panel_variant</item>
        <item name="colorOnSurface">@color/teal_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/teal_text_dim</item>
        <item name="colorOutline">@color/teal_outline</item>
        <item name="colorOutlineVariant">@color/teal_outline</item>
    </style>

    <style name="Theme.Pause.Lavender" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="pNight">@color/lavender_night</item>
        <item name="pPanel">@color/lavender_panel</item>
        <item name="pPanelVariant">@color/lavender_panel_variant</item>
        <item name="pBreath">@color/lavender_breath</item>
